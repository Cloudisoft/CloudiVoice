{"id":"receptionist-en","scenario":"receptionist","language":"en-IN","business":"Sunrise Multispeciality Clinic","agentName":"Ananya","callerName":"Priya","src":"/samples/receptionist-en.mp3","durationMs":42792,"segments":[{"speaker":"agent","name":"Ananya","text":"Hello! This is Ananya from Sunrise Clinic. How can I help you today?","startMs":350,"endMs":4815},{"speaker":"caller","name":"Priya","text":"Hi, I'd like to see a dermatologist this week, if possible.","startMs":5405,"endMs":10445},{"speaker":"agent","name":"Ananya","text":"Of course. Dr. Rao, our dermatologist, has openings tomorrow at eleven thirty in the morning, or at five in the evening. Which one works for you?","startMs":10905,"endMs":20585},{"speaker":"caller","name":"Priya","text":"Eleven thirty is perfect.","startMs":21255,"endMs":22775},{"speaker":"agent","name":"Ananya","text":"Lovely. May I have the patient's name, please?","startMs":23175,"endMs":25814},{"speaker":"caller","name":"Priya","text":"Priya Menon.","startMs":26424,"endMs":27222},{"speaker":"agent","name":"Ananya","text":"Thank you, Priya. You're booked with Dr. Rao tomorrow at eleven thirty. The consultation fee is eight hundred rupees. Is there anything else I can help with?","startMs":27702,"endMs":36182},{"speaker":"caller","name":"Priya","text":"No, that's all. Thanks!","startMs":36732,"endMs":38652},{"speaker":"agent","name":"Ananya","text":"You're welcome. See you tomorrow, and have a lovely day!","startMs":39072,"endMs":42192}],"events":[{"atMs":27222,"label":"book_appointment ▸ Dr. Rao · tomorrow 11:30 AM"}],"peaks":{"agent":[0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.279,0.954,0.898,0.667,0.638,0.534,0.599,0.223,0.029,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.578,0.804,0.575,0.169,0.58,0.302,0.902,0.904,0.727,0.273,0.685,0.693,0.49,0.308,0.573,0.7,0.732,0.621,0.611,0.122,0.151,0.911,0.763,0.654,0.313,0.267,0.219,0.151,0.936,0.88,0.313,0.331,0.504,0.786,0.9,0.875,0.679,0.534,0.373,0.275,0.169,0.0