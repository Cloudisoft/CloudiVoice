{"id":"recruitment-en","scenario":"recruitment","language":"en-IN","business":"TalentBridge Staffing","agentName":"Simran","callerName":"Vikram","src":"/samples/recruitment-en.mp3","durationMs":50455,"segments":[{"speaker":"agent","name":"Simran","text":"Hi Vikram, this is Simran from the TalentBridge hiring team. You applied for the Customer Support Executive role in Bengaluru. Is this a good time to talk?","startMs":350,"endMs":9847},{"speaker":"caller","name":"Vikram","text":"Yes, absolutely.","startMs":10437,"endMs":12395},{"speaker":"agent","name":"Simran","text":"Great. How many years of customer-facing experience do you have?","startMs":12855,"endMs":17895},{"speaker":"caller","name":"Vikram","text":"About two years, at a telecom call centre.","startMs":18565,"endMs":21285},{"speaker":"agent","name":"Simran","text":"That's helpful. And what's your current notice period?","startMs":21685,"endMs":25179},{"speaker":"caller","name":"Vikram","text":"Thirty days.","startMs":25789,"endMs":26717},{"speaker":"agent","name":"Simran","text":"Perfect. Are you comfortable speaking with customers in both Hindi and English?","startMs":27197,"endMs":31663},{"speaker":"caller","name":"Vikram","text":"Yes, I use both every day.","startMs":32213,"endMs":34233},{"speaker":"agent","name":"Simran","text":"Wonderful. I'd like to schedule your interview. Would Thursday at eleven in the morning or three in the afternoon suit you better?","startMs":34653,"endMs":42067},{"speaker":"caller","name":"Vikram","text":"Three in the afternoon, please.","startMs":42697,"endMs":44178},{"speaker":"agent","name":"Simran","text":"You're all set for Thursday at three. You'll get the details by email. All the best, Vikram!","startMs":44678,"endMs":49855}],"events":[{"atMs":34233,"label":"mark_qualified ▸ 2 yrs · 30-day notice · Hindi + English"},{"atMs":44178,"label":"book_appointment ▸ Interview · Thursday 3:00 PM"}],"peaks":{"agent":[0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.003,0.412,0.96