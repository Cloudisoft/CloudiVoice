# ---------------------------------------------------------------------------
# CloudiVoice environment. Copy to .env (never commit real values).
# Web app (apps/web) and voice gateway (apps/voice) read the same variables.
# ---------------------------------------------------------------------------

# Postgres connection (migrations run automatically on boot)
DATABASE_URL=postgres://postgres@localhost:5432/cloudivoice

# Public URLs
APP_URL=http://localhost:3000             # the web app
VOICE_PUBLIC_URL=http://localhost:8080    # the voice gateway; must be public HTTPS in production

# Secrets — generate with: openssl rand -hex 32
APP_SECRET=                               # signs sessions, media-stream and demo tokens (shared by web + voice)
ENCRYPTION_KEY=                           # 32-byte key (hex/base64) for credentials stored at rest

# Telephony connection (server-side only; see docs/internal/telephony.md)
TELEPHONY_PROVIDER=plivo
TELEPHONY_AUTH_ID=
TELEPHONY_AUTH_TOKEN=
TELEPHONY_STREAM_FORMAT=mulaw-8k          # or l16-16k for wideband audio

# Speech engine (speech-to-text + text-to-speech for Indian languages)
SPEECH_API_KEY=
# SPEECH_API_BASE=https://api.sarvam.ai
# STT_MODEL=saaras:v3
# TTS_MODEL=bulbul:v3

# Reasoning engine
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5               # fast, low-latency replies for live calls
# LLM_EFFORT=low                         # used only by models that support effort (not Haiku 4.5)

# Languages enabled after validation on your speech stack
ENABLED_LANGUAGES=hi-IN,en-IN

# Public demo guard rails
DEMO_MAX_SECONDS=120
DEMO_SESSIONS_PER_IP_PER_DAY=5
DEMO_DAILY_CEILING_SECONDS=14400

# Email (password resets, invitations). Without SMTP in development, links are shown on screen.
SMTP_URL=                                 # e.g. smtps://user:pass@smtp.example.com:465
MAIL_FROM="CloudiVoice <no-reply@cloudisoft.com>"

# Storage for recordings (private; served only through signed, expiring links)
STORAGE_DIR=./storage

# Pricing (integer paise). Optional JSON override of packages/core/src/pricing.ts defaults.
# PRICING_JSON={"perMinute":{"telephony":45,"speech_to_text":40,"reasoning":60,"text_to_speech":60,"platform":45}}

# Cloudisoft operators who may see cross-tenant system health and replay webhooks
PLATFORM_ADMIN_EMAILS=info@cloudisoft.com

# Worker
# WORKER_ID=voice-1
# DISABLE_WORKER=1                        # run a gateway replica without background jobs
